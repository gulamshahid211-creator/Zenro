<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zenro AI - Long Video Generator</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        body { background-color: #0f172a; color: #f8fafc; padding: 20px; text-align: center; }
        .container { max-width: 700px; margin: 0 auto; background: #1e293b; padding: 25px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.4); }
        h1 { color: #38bdf8; font-size: 2.2rem; }
        .tagline { color: #94a3b8; font-size: 0.95rem; margin-bottom: 20px; }
        .pricing-card { background: #334155; padding: 18px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #475569; }
        .price { font-size: 1.6rem; color: #4ade80; font-weight: bold; margin: 5px 0; }
        .badge { background: #eab308; color: #0f172a; padding: 3px 8px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; }
        .prompt-box { text-align: left; margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; color: #cbd5e1; }
        textarea { width: 100%; height: 110px; padding: 10px; background: #0f172a; color: #fff; border: 1px solid #475569; border-radius: 6px; resize: none; font-size: 0.95rem; }
        .btn { background: #0284c7; color: white; border: none; padding: 10px 18px; font-size: 0.95rem; border-radius: 6px; cursor: pointer; transition: 0.2s; margin: 4px; }
        .btn:hover { background: #0369a1; }
        .btn-success { background: #16a34a; }
        .btn-success:hover { background: #15803d; }
        .btn-prompt { background: #6366f1; font-size: 0.85rem; padding: 6px 12px; margin-bottom: 8px; }
        .qr-modal { display: none; background: #0f172a; padding: 15px; border-radius: 8px; margin-top: 15px; border: 1px solid #38bdf8; }
        .qr-modal img { max-width: 220px; border-radius: 6px; border: 3px solid #fff; margin: 10px 0; }
        input[type="text"] { width: 80%; padding: 8px; border-radius: 4px; border: 1px solid #475569; background: #1e293b; color: #fff; text-align: center; margin-top: 8px; }
        #statusMessage { margin-top: 15px; font-weight: bold; font-size: 0.95rem; }
    </style>
</head>
<body>

    <div class="container">
        <h1>Zenro AI</h1>
        <p class="tagline">Generate High-Quality Cinematic Long Videos in Minutes</p>

        <!-- Subscription Section -->
        <div class="pricing-card">
            <h3>Zenro Pro Plan</h3>
            <div class="price">₹499 / Month</div>
            <p><span class="badge">FREE OFFER</span> First 2 Long Videos FREE!</p>
            <p style="font-size: 0.85rem; color: #94a3b8; margin-top: 5px;">Extra Videos: ₹8 per video</p>
            <button class="btn btn-success" onclick="toggleQR()">Buy Subscription / QR Pay</button>
        </div>

        <!-- Payment Modal -->
        <div id="qrSection" class="qr-modal">
            <h4>Scan QR Code to Pay ₹499</h4>
            <p style="font-size: 0.85rem; color: #94a3b8;">Pay via PhonePe, Paytm, Google Pay, or BHIM</p>
            <!-- Ensure your uploaded image file name is qr.jpg -->
            <img src="qr.jpg" alt="Zenro AI Payment QR Code" onerror="this.onerror=null; this.src='https://via.placeholder.com/200?text=Upload+QR+as+qr.jpg';">
            <br>
            <input type="text" id="txnId" placeholder="Enter 12-Digit UTR / Transaction ID">
            <br>
            <button class="btn btn-success" style="margin-top: 10px;" onclick="submitPayment()">Submit Payment</button>
        </div>

        <!-- AI Prompt Box -->
        <div class="prompt-box">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <label for="videoPrompt">Enter Video Prompt:</label>
                <button class="btn btn-prompt" onclick="useBestPrompt()">✨ Auto Best Prompt</button>
            </div>
            <textarea id="videoPrompt" placeholder="Write what kind of video you want to generate..."></textarea>
        </div>

        <button class="btn" style="width: 100%; padding: 12px; font-weight: bold;" onclick="generateVideo()">🎬 Generate Long Video</button>

        <div id="statusMessage"></div>
    </div>

    <script>
        let freeLeft = 2;

        function toggleQR() {
            const qr = document.getElementById('qrSection');
            qr.style.display = qr.style.display === 'block' ? 'none' : 'block';
        }

        function useBestPrompt() {
            document.getElementById('videoPrompt').value = "Create a 10-minute cinematic 4K video about deep space exploration, ultra-realistic visual effects, soft dramatic background music, clear hindi voiceover narration, 60fps high quality render.";
        }

        function submitPayment() {
            const txn = document.getElementById('txnId').value.trim();
            if (txn.length < 6) {
                alert("Kripya sahi 12-digit Transaction ID enter karein.");
            } else {
                alert("Aapka payment reference submit ho gaya hai! Account 10 minute me activate ho jayega.");
                toggleQR();
            }
        }

        function generateVideo() {
            const prompt = document.getElementById('videoPrompt').value.trim();
            const status = document.getElementById('statusMessage');

            if (!prompt) {
                alert("Pehle prompt likhein ya 'Auto Best Prompt' button dabayein!");
                return;
            }

            if (freeLeft > 0) {
                freeLeft--;
                status.style.color = "#38bdf8";
                status.innerHTML = `⏳ Video Processing... (Free Trial: ${freeLeft} Video Left)`;
            } else {
                status.style.color = "#f87171";
                status.innerHTML = `⚠️ Free limit khatam! Agli video ke liye ₹8 pay karein ya ₹499 monthly subscription lein.`;
            }
        }
    </script>

</body>
</html>

